{
  "name": "@nexla/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for Nexla",
  "author": "Nexla, Inc.",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexla-opensource/nexla-sdk-js.git",
    "directory": "packages/ts-sdk"
  },
  "homepage": "https://github.com/nexla-opensource/nexla-sdk-js/tree/main/packages/ts-sdk#readme",
  "bugs": {
    "url": "https://github.com/nexla-opensource/nexla-sdk-js/issues"
  },
  "keywords": [
    "nexla",
    "sdk",
    "api",
    "data-platform",
    "typescript",
    "etl",
    "data-integration"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "license": "MIT",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "gen:merged-spec": "node ./scripts/build-merged-spec.mjs",
    "gen:types": "openapi-typescript src/generated/merged-spec.json -o src/generated/schema.ts",
    "gen:resources": "node ./scripts/generate-resource-map.mjs",
    "gen:spec-metadata": "node ./scripts/generate-spec-metadata.mjs",
    "gen": "pnpm run gen:merged-spec && pnpm run gen:types && pnpm run gen:resources && pnpm run gen:spec-metadata",
    "check:generated": "node ./scripts/check-generated-coverage.mjs",
    "check:backend-drift": "node ./scripts/check-backend-drift.mjs",
    "publint": "publint --strict",
    "attw": "attw --pack .",
    "size": "size-limit",
    "smoke:consumer": "node ./scripts/consumer-smoke.mjs",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "openapi-fetch": "^0.10.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^20.11.30",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^6.7.6",
    "openapi-typescript-helpers": "^0.0.11",
    "prettier": "^3.10.0",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^2.1.8",
    "yaml": "^2.4.5"
  },
  "size-limit": [
    {
      "name": "ESM entry (dist/index.js, brotli)",
      "path": "dist/index.js",
      "limit": "35 kB"
    },
    {
      "name": "CJS entry (dist/index.cjs, brotli)",
      "path": "dist/index.cjs",
      "limit": "36 kB"
    }
  ]
}
